# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in (Google Cloud console → Credentials → OAuth 2.0 client IDs)
# Web client ID (the one Firebase Auth created) — used to get an ID token for Firebase
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: the iOS client ID and its reversed form (com.googleusercontent.apps.xxxx)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# Expo project ID (from `npx eas-cli@latest init`) — needed for push tokens
EAS_PROJECT_ID=
